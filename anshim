<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>이실장 안심케어 OX 퀴즈</title>
    <style>
        @font-face {
            font-family: 'Pretendard';
            src: url('https://cdn.jsdelivr.net/gh/Project-Noonnu/noonfonts_2107@1.1/Pretendard-Regular.woff') format('woff');
            font-weight: 400; font-style: normal;
            font-display: swap;
        }
        :root {
            --primary: #4285F4; 
            --primary-light: #E8F0FE;
            --success: #34A853;
            --danger: #EA4335;
            --bg: #F8F9FA;
            --text: #3C4043;
        }
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: var(--bg); margin: 0;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; overflow-x: hidden;
        }
        #app {
            width: 90%;
            max-width: 1000px;
            min-height: 600px;
            background: white; padding: 40px;
            border-radius: 32px; box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
            text-align: center; position: relative;
            display: flex; flex-direction: column; justify-content: center;
            box-sizing: border-box; margin: 20px;
        }

        /* 진행 상태 표시줄 */
        .progress-container {
            width: 100%; height: 8px; background: #E8EAED;
            border-radius: 10px; position: absolute; top: 0; left: 0; overflow: hidden;
        }
        .progress-bar {
            width: 0%; height: 100%; background: var(--primary);
            transition: width 0.3s ease;
        }

        .nav-controls {
            position: absolute; top: 20px; left: 20px; right: 20px;
            display: flex; justify-content: space-between; align-items: center;
        }
        .nav-btn {
            background: #fff; border: 1px solid #DADCE0; padding: 8px 16px;
            border-radius: 100px; font-size: 0.9rem; color: #5F6368;
            cursor: pointer; transition: all 0.2s;
        }

        h1 { font-size: clamp(2rem, 8vw, 4rem); margin: 0; color: var(--text); letter-spacing: -1px; }
        .question-text { 
            font-size: clamp(1.5rem, 5vw, 3rem); font-weight: 800; 
            line-height: 1.4; margin: 30px 0; min-height: 150px; 
            word-break: keep-all; color: #202124; 
        }

        .btn-group { display: flex; gap: 20px; justify-content: center; width: 100%; }
        .btn-ox {
            flex: 1; max-width: 250px; aspect-ratio: 1 / 1;
            font-size: clamp(4rem, 15vw, 8rem); font-weight: 900;
            border: none; border-radius: 24px; cursor: pointer;
            color: white; transition: transform 0.1s;
        }
        .btn-o { background: var(--success); box-shadow: 0 8px 0 #288d44; }
        .btn-x { background: var(--danger); box-shadow: 0 8px 0 #c53929; }
        .btn-ox:active { transform: translateY(4px); box-shadow: none; }

        #overlay {
            display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            z-index: 100; justify-content: center; align-items: center; flex-direction: column;
            padding: 20px; box-sizing: border-box;
        }
        #result-mark { font-size: clamp(3rem, 10vw, 6rem); font-weight: 900; color: white; margin-bottom: 20px; }
        .explanation-card { 
            background: white; padding: 30px; border-radius: 20px; 
            max-width: 600px; width: 100%; font-size: clamp(1.1rem, 4vw, 1.8rem); 
            line-height: 1.6; box-shadow: 0 20px 40px rgba(0,0,0,0.2); 
        }

        .next-btn { 
            margin-top: 30px; padding: 15px 60px; font-size: 1.5rem; 
            font-weight: bold; border-radius: 100px; border: none; cursor: pointer;
        }

        /* 최종 결과 페이지 */
        .rank-title { font-size: 2.2rem; font-weight: 900; color: var(--primary); margin: 10px 0; }
        .rank-desc { font-size: 1.1rem; color: #5F6368; line-height: 1.5; padding: 0 10px; }
        .bottom-section { 
            display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; 
            border-top: 1px solid #DADCE0; padding-top: 30px; margin-top: 30px; width: 100%;
        }
        .qr-area { display: flex; align-items: center; gap: 15px; background: #fff; padding: 10px; border-radius: 15px; border: 1px solid #DADCE0; }
        .qr-img { width: 80px; height: 80px; }

        .arcade-btn {
            font-size: 1.8rem; padding: 20px 60px; background: var(--primary); color: white; 
            border: none; border-radius: 100px; font-weight: bold; cursor: pointer;
            box-shadow: 0 8px 0 #2854a8;
        }

        /* 모바일 대응 미디어 쿼리 */
        @media (max-width: 600px) {
            #app { padding: 30px 15px; border-radius: 20px; }
            .btn-group { gap: 15px; }
            .btn-ox { border-radius: 15px; }
            .qr-area { width: 100%; justify-content: center; }
        }
    </style>
</head>
<body>
<canvas id="confetti-canvas" style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:150;"></canvas>

<div id="app">
    <div class="progress-container" id="progress-container" style="display: none;">
        <div class="progress-bar" id="progress-bar"></div>
    </div>
    <div class="nav-controls" id="nav-controls" style="display: none;">
        <button class="nav-btn" onclick="prevQuestion()" id="prev-btn">❮ 이전</button>
        <button class="nav-btn" onclick="renderStart()">처음으로</button>
    </div>
    <div id="content"></div>
</div>

<div id="overlay">
    <div id="result-mark"></div>
    <div class="explanation-card" id="explanation"></div>
    <button class="next-btn" onclick="closeOverlay()">다음으로 ❯</button>
</div>

<script>
    const allQuestions = [
        { q: "등기부등본을 계약서 작성 당일에|확인하면 대항력 확보를 할 수있다.", a: "X", desc: "잔금 지급 직후와 전입신고 직후까지 변동 사항을 실시간으로 확인해야 안전합니다." },
        { q: "공동명의 주택 계약 시, 지분권자 과반의|동의가 없다면 계약이 무효될 수 있다.", a: "O", desc: "공유물 관리 행위는 지분의 과반수로 결정해야 하므로 전원의 동의나 위임장 확인이 필수입니다." },
        { q: "전입신고 당일 설정된 저당권은|세입자의 대항력보다 후순위이다.", a: "X", desc: "전입신고 효력은 익일 0시에 발생하므로, 당일 설정된 저당권이 법적으로 앞섭니다." },
        { q: "이실장 안심케어는 전세 사기 피해 시|실손금을 보상해 줄까요?", a: "O", desc: "네! 권리관계 문제로 보증금을 잃게 될 경우 실손 보상을 지원합니다." },
        { q: "확정일자는 해당 주택에|실거주를 시작한 이후에 부여받을 수 있다.", a: "X", desc: "임대차 계약서만 있다면 입주 전이라도 주민센터나 온라인을 통해 미리 받을 수 있습니다." }
    ];

    let quizSet = [];
    let currentIdx = 0;
    let score = 0;

    function renderStart() {
        document.getElementById('progress-container').style.display = 'none';
        document.getElementById('nav-controls').style.display = 'none';
        document.getElementById('content').innerHTML = `
            <div class="start-container">
                <div style="color:var(--primary); font-weight:800; margin-bottom:20px;">이실장 안심케어</div>
                <h1 style="margin-bottom:40px;">내 보증금 지키는<br>안심 OX 퀴즈</h1>
                <button class="arcade-btn" onclick="startQuiz()">시작하기</button>
            </div>
        `;
    }

    function startQuiz() {
        quizSet = [...allQuestions].sort(() => Math.random() - 0.5).slice(0, 3);
        currentIdx = 0; score = 0;
        document.getElementById('progress-container').style.display = 'block';
        document.getElementById('nav-controls').style.display = 'flex';
        showQuestion();
    }

    function showQuestion() {
        const qData = quizSet[currentIdx];
        const progress = ((currentIdx) / quizSet.length) * 100;
        document.getElementById('progress-bar').style.width = `${progress}%`;
        document.getElementById('prev-btn').style.visibility = currentIdx > 0 ? 'visible' : 'hidden';

        document.getElementById('content').innerHTML = `
            <div style="font-weight:bold; color:var(--primary); margin-bottom:10px;">Q ${currentIdx + 1} / ${quizSet.length}</div>
            <div class="question-text">${qData.q.replace('|', '<br>')}</div>
            <div class="btn-group">
                <button class="btn-ox btn-o" onclick="checkAnswer('O')">O</button>
                <button class="btn-ox btn-x" onclick="checkAnswer('X')">X</button>
            </div>
        `;
    }

    function checkAnswer(userAns) {
        const isCorrect = userAns === quizSet[currentIdx].a;
        const overlay = document.getElementById('overlay');
        const mark = document.getElementById('result-mark');
        
        if (isCorrect) { 
            score++; 
            overlay.style.backgroundColor = "rgba(52, 168, 83, 0.98)"; 
            mark.innerText = "🙆🏻 정답입니다!"; 
        } else { 
            overlay.style.backgroundColor = "rgba(234, 67, 53, 0.98)"; 
            mark.innerText = "🙅🏻‍♂️ 아쉽습니다!"; 
        }
        
        document.getElementById('explanation').innerHTML = `<small>CHECK</small><br>${quizSet[currentIdx].desc}`;
        overlay.style.display = 'flex';
    }

    function closeOverlay() {
        document.getElementById('overlay').style.display = 'none';
        currentIdx++;
        if (currentIdx < quizSet.length) {
            showQuestion();
        } else {
            document.getElementById('progress-bar').style.width = `100%`;
            showFinalResult();
        }
    }

    function prevQuestion() { if (currentIdx > 0) { currentIdx--; showQuestion(); } }

    function showFinalResult() {
        document.getElementById('nav-controls').style.display = 'none';
        let emoji = score === 3 ? "🐔" : (score === 2 ? "🐥" : "🐣");
        let rank = score === 3 ? "안심 만렙 장닭" : (score === 2 ? "똘똘한 병아리" : "무방비 알맹이");

        document.getElementById('content').innerHTML = `
            <div style="font-size:5rem;">${emoji}</div>
            <div class="rank-title">${rank}</div>
            <p class="rank-desc">총 3문제 중 ${score}문제를 맞히셨습니다!</p>
            <div class="bottom-section">
                <div class="qr-area">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://cc.aipartner.com/" class="qr-img">
                    <div style="text-align:left; font-size:0.9rem;"><b>내 보증금 지키기</b><br>안심케어 확인하기</div>
                </div>
                <button class="next-btn" onclick="renderStart()" style="background:#eee; color:#666;">다시하기</button>
            </div>
        `;
    }

    renderStart();
</script>
</body>
</html>
